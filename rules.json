{
  "version": "1.0",
  "rules": [
    {
      "id": "R001",
      "name": "SSH Brute Force",
      "description": "Multiple failed SSH login attempts from a single IP",
      "protocol": "TCP",
      "port": 22,
      "threshold": 20,
      "window_seconds": 60,
      "severity": "HIGH",
      "action": "alert"
    },
    {
      "id": "R002",
      "name": "SQL Injection Pattern",
      "description": "HTTP request body contains common SQL injection strings",
      "protocol": "TCP",
      "port": 80,
      "patterns": ["' OR ", "1=1", "UNION SELECT", "DROP TABLE", "--"],
      "severity": "CRITICAL",
      "action": "block_and_alert"
    },
    {
      "id": "R003",
      "name": "Port Scan Detection",
      "description": "Single source IP hitting more than 15 distinct ports in 30 seconds",
      "threshold_ports": 15,
      "window_seconds": 30,
      "severity": "MEDIUM",
      "action": "alert"
    },
    {
      "id": "R004",
      "name": "DNS Tunneling",
      "description": "Unusually high DNS query rate from internal host to external resolver",
      "protocol": "UDP",
      "port": 53,
      "threshold": 50,
      "window_seconds": 60,
      "severity": "HIGH",
      "action": "alert"
    },
    {
      "id": "R005",
      "name": "RDP Brute Force",
      "description": "Repeated RDP connection failures",
      "protocol": "TCP",
      "port": 3389,
      "threshold": 10,
      "window_seconds": 60,
      "severity": "MEDIUM",
      "action": "alert"
    }
  ]
}
